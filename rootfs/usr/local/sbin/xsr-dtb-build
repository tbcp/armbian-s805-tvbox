#!/usr/bin/python3 -I
"""
Build /boot/dtb/meson8b-xsr.dtb from Armbian's stock meson8b-mxq.dtb, moving the
SD card slot from the slow "sdio" controller (meson-mx-sdio) to the "sdhc"
controller (meson-mx-sdhc) via the sdxc_b pin group (CARD_0..CARD_4).

The stock DTB has no __symbols__, so a normal overlay can't be used; the DTB is
decompiled, edited, and recompiled. Runs on the box (needs device-tree-compiler).
If anything doesn't match expectations, the custom DTB is REMOVED so that
s805_autoscript falls back to the stock meson8b-mxq.dtb.

Usage: xsr-dtb-build [base.dtb] [out.dtb]
"""
import os, re, subprocess, sys, tempfile

BASE = sys.argv[1] if len(sys.argv) > 1 else "/boot/dtb/meson8b-mxq.dtb"
OUT = sys.argv[2] if len(sys.argv) > 2 else "/boot/dtb/meson8b-xsr.dtb"
SD_MAX_FREQ = 50000000  # SD high-speed, 3.3 V signalling only on this board


def fail(msg):
    print(f"xsr-dtb-build: {msg}; removing {OUT} (stock DTB will be used)")
    try:
        os.remove(OUT)
    except FileNotFoundError:
        pass
    sys.exit(0)


def block(text, header):
    """Return (start, end) of the node starting with `header {` (balanced braces)."""
    m = re.search(r"^(\s*)" + re.escape(header) + r" \{\n", text, re.M)
    if not m:
        fail(f"node '{header}' not found")
    depth, i = 0, m.end() - 2
    while i < len(text):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                return m.start(), text.index("\n", i) + 1
        i += 1
    fail(f"unbalanced node '{header}'")


try:
    dts = subprocess.run(["dtc", "-q", "-I", "dtb", "-O", "dts", BASE],
                         capture_output=True, text=True, check=True).stdout
except (OSError, subprocess.CalledProcessError) as e:
    fail(f"cannot decompile {BASE}: {e}")

if "sdxc-b {" in dts:
    fail("base DTB already has an sdxc-b node, refusing to patch twice")

# --- 1. read card-detect GPIO + vmmc supply from the stock sdio slot, then disable sdio
s, e = block(dts, "mmc@8c20")
sdio = dts[s:e]
if "meson-mx-sdio" not in sdio:
    fail("mmc@8c20 is not the meson-mx-sdio controller")
cd = re.search(r"cd-gpios = (<[^>]+>);", sdio)
vmmc = re.search(r"vmmc-supply = (<[^>]+>);", sdio)
if not (cd and vmmc):
    fail("cd-gpios / vmmc-supply not found in sdio slot")
sdio_new = sdio.replace('status = "okay";', 'status = "disabled";', 1)
dts = dts[:s] + sdio_new + dts[e:]

# --- 2. new phandle for the sdxc_b pinctrl node
phandles = [int(x, 16) for x in re.findall(r"phandle = <(0x[0-9a-f]+)>;", dts)]
ph = max(phandles) + 1

# --- 3. add the sdxc-b pin group under the cbus pinctrl
s, e = block(dts, "pinctrl@9880")
pc = dts[s:e]
indent = re.match(r"(\s*)", pc).group(1)
node = (f"{indent}\tsdxc-b {{\n"
        f"{indent}\t\tphandle = <{ph:#x}>;\n"
        f"{indent}\t\tmux {{\n"
        f'{indent}\t\t\tgroups = "sdxc_d0_b", "sdxc_d13_b", "sdxc_clk_b", "sdxc_cmd_b";\n'
        f'{indent}\t\t\tfunction = "sdxc_b";\n'
        f"{indent}\t\t\tbias-pull-up;\n"
        f"{indent}\t\t}};\n"
        f"{indent}\t}};\n")
close = pc.rstrip().rfind("};")
pc_new = pc[:close].rstrip("\t") + node + indent + pc[close:]
dts = dts[:s] + pc_new + dts[e:]

# --- 4. enable sdhc with the SD card slot properties
s, e = block(dts, "mmc@8e00")
sdhc = dts[s:e]
if "meson-mx-sdhc" not in sdhc or 'status = "disabled";' not in sdhc:
    fail("mmc@8e00 is not a disabled meson-mx-sdhc controller")
ind = re.match(r"(\s*)", sdhc).group(1) + "\t"
props = (f'status = "okay";\n'
         f"{ind}pinctrl-0 = <{ph:#x}>;\n"
         f'{ind}pinctrl-names = "default";\n'
         f"{ind}bus-width = <0x04>;\n"
         f"{ind}max-frequency = <{SD_MAX_FREQ:#x}>;\n"
         f"{ind}cap-sd-highspeed;\n"
         f"{ind}cap-mmc-highspeed;\n"
         f"{ind}disable-wp;\n"
         f"{ind}no-sdio;\n"
         f"{ind}cd-gpios = {cd.group(1)};\n"
         f"{ind}vmmc-supply = {vmmc.group(1)};")
sdhc_new = sdhc.replace('status = "disabled";', props, 1)
dts = dts[:s] + sdhc_new + dts[e:]

# --- 5. compile and install atomically
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(OUT), suffix=".dtb")
os.close(fd)
r = subprocess.run(["dtc", "-q", "-I", "dts", "-O", "dtb", "-o", tmp, "-"],
                   input=dts, text=True, capture_output=True)
if r.returncode != 0:
    os.remove(tmp)
    fail(f"dtc failed: {r.stderr.strip()}")
os.replace(tmp, OUT)
print(f"xsr-dtb-build: wrote {OUT} (SD slot on sdhc/sdxc_b, phandle {ph:#x}, "
      f"cd-gpios {cd.group(1)}, vmmc {vmmc.group(1)})")
